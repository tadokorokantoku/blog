---
import '../styles/news-trend.css';
import '../styles/news-trend-labels.css';
import type { TrendRepo, TrendSeries } from '../lib/trend';

// 順位推移のバンプチャート。期間ごとにビルド時に描いておき、切り替えは hidden の付け外しだけにする。
// グラフは高さ固定で横に伸び縮みする（preserveAspectRatio="none"）。線と点は non-scaling-stroke で歪ませず、
// 文字は SVG の外の HTML に置く。右のラベル列はグラフと同じ高さで、はみ出す分はその中でスクロールする
interface Props {
  ranges: { id: string; label: string; series: TrendSeries }[];
}

const { ranges } = Astro.props;

// 色を付けるのは最終日の上位8件だけ（dataviz の検証済みパレットが8色）。残りは落ち着いた色で、触れたときだけ濃くする。
// どの期間も最後の日は同じなので、同じリポジトリは期間を変えても同じ色になる
const SERIES = 8;
const colorOf = new Map(
  (ranges[0]?.series.repos ?? [])
    .filter(({ lastRank }) => lastRank !== undefined)
    .slice(0, SERIES)
    .map(({ url }, i) => [url, i + 1]),
);

// viewBox の座標。縦は 1〜10 位を上下に余白を取って並べる
const VW = 1000;
const VH = 1000;
const PAD_Y = 50;
const PAD_X = 20;
const y = (rank: number) => PAD_Y + ((rank - 1) * (VH - PAD_Y * 2)) / 9;
const pct = (value: number, of: number) => `${((value / of) * 100).toFixed(2)}%`;

const MD = new Intl.DateTimeFormat('ja-JP', { month: 'numeric', day: 'numeric', timeZone: 'UTC' });
const shortDay = (day: string) => MD.format(new Date(`${day}T00:00:00Z`));
const repoName = (title: string) => title.split('/').at(-1) ?? title;

// 最終日の印だけをバッジにする。途中の日の印は出さない
function badge(repo: TrendRepo) {
  const mark = repo.points.at(-1)?.mark;
  if (mark?.kind === 'new') return { text: 'NEW', kind: 'new' };
  if (mark?.kind === 'surge') return { text: `↑${mark.by}`, kind: 'surge' };
  return undefined;
}

function layout(series: TrendSeries) {
  const n = series.days.length;
  const x = (i: number) => (n === 1 ? VW / 2 : PAD_X + (i * (VW - PAD_X * 2)) / (n - 1));
  // 日付は5個くらいまで。最後の日は必ず出し、その直前の目盛りが近すぎるときは間引く（スマホで重なるので）
  const step = Math.ceil(n / 5);
  const ticks = series.days.flatMap((day, i) =>
    i === n - 1 || (i % step === 0 && n - 1 - i >= step * 0.6) ? [{ left: pct(x(i), VW), label: shortDay(day) }] : [],
  );

  const lines = series.repos.map((repo, key) => {
    // 隣り合う日を S 字の曲線でつなぐ。ランク外の日で切れ、途中で消えたものは最後に居た点で終わる
    const segments: string[] = [];
    let d = '';
    repo.points.forEach((point, i) => {
      const prev = repo.points[i - 1];
      if (!point) {
        if (d) segments.push(d);
        d = '';
        return;
      }
      if (d && prev) {
        const mid = (x(i - 1) + x(i)) / 2;
        d += ` C${mid} ${y(prev.rank)} ${mid} ${y(point.rank)} ${x(i)} ${y(point.rank)}`;
      } else {
        d = `M${x(i)} ${y(point.rank)}`;
      }
    });
    if (d) segments.push(d);
    const dots = repo.points.flatMap((point, i) =>
      point
        ? [{ d: `M${x(i)} ${y(point.rank)}h0`, title: `${shortDay(series.days[i])} ${point.rank}位${point.stars ? ` ★${point.stars.toLocaleString('ja-JP')}` : ''}` }]
        : [],
    );
    return { repo, key, color: colorOf.get(repo.url), segments, dots, badge: badge(repo) };
  });

  // 描く順は、色の無い線 → 色付きの下位 → 上位。上位の線がいちばん上に重なる
  const order = (color: number | undefined) => (color ? SERIES + 1 - color : 0);
  const drawn = [...lines].sort((a, b) => order(a.color) - order(b.color));
  return { n, ticks, lines, drawn };
}

const views = ranges.map((range) => ({ ...range, ...layout(range.series) }));
---

<div class="trend" data-trend>
  {
    views.length > 1 && (
      <div class="trend-ranges" role="group" aria-label="期間">
        {views.map((view, i) => (
          <button type="button" class="trend-range" data-range={view.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {view.label}
          </button>
        ))}
      </div>
    )
  }
  {
    views.map((view, i) => (
      <figure class="trend-figure" data-range={view.id} hidden={i !== 0}>
        <div class="trend-body">
          <div class="trend-plot">
            <div class="trend-canvas">
              {[1, 5, 10].map((rank) => (
                <span class="trend-axis" style={`top: ${pct(y(rank), VH)}`}>
                  {rank}
                </span>
              ))}
              <svg class="trend-svg" viewBox={`0 0 ${VW} ${VH}`} preserveAspectRatio="none" role="img" aria-label={`${view.label}の順位推移。${view.n}日分、${view.lines.length}リポジトリ`}>
                {Array.from({ length: 10 }, (_, r) => (
                  <line class="trend-grid" x1="0" x2={VW} y1={y(r + 1)} y2={y(r + 1)} />
                ))}
                {view.drawn.map(({ repo, key, color, segments, dots }) => (
                  <g class:list={['trend-line', { 'is-other': !color }]} data-key={key} style={color ? `--c: var(--series-${color})` : undefined}>
                    {segments.map((d) => (
                      <>
                        <path class="trend-hit" d={d} />
                        <path class="trend-path" d={d} />
                      </>
                    ))}
                    {dots.map((dot) => (
                      <>
                        <path class="trend-hit" d={dot.d} />
                        <path class="trend-dot" d={dot.d}>
                          <title>{`${repo.title} ${dot.title}`}</title>
                        </path>
                      </>
                    ))}
                  </g>
                ))}
              </svg>
              <div class="trend-ticks" aria-hidden="true">
                {view.ticks.map((tick) => (
                  <span style={`left: ${tick.left}`}>{tick.label}</span>
                ))}
              </div>
            </div>
          </div>
          <div class="trend-labels">
            <ol class="trend-label-list">
              {view.lines.map(({ repo, key, color, badge }) => (
                <li class:list={['trend-label', { 'is-other': !color, 'is-gone': repo.lastRank === undefined }]} data-key={key} style={color ? `--c: var(--series-${color})` : undefined}>
                  <span class="trend-pill" title={repo.lastRank ? `最終日 ${repo.lastRank}位` : `最高 ${repo.bestRank}位`}>
                    {repo.lastRank ?? '—'}
                  </span>
                  <button type="button" class="trend-name">
                    {repoName(repo.title)}
                  </button>
                  {badge && <span class:list={['trend-badge', `is-${badge.kind}`]}>{badge.text}</span>}
                  {!repo.lastRank && <span class="trend-best">最高{repo.bestRank}位</span>}
                  <a href={repo.url} target="_blank" rel="noopener noreferrer" aria-label={`${repo.title} を GitHub で開く`}>
                    ↗
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </div>
        <figcaption class="trend-caption">
          {view.n}日間に1日でもランク入りした{view.lines.length}件。色付きは最終日の上位8件。線か右の名前に触れるとその1本だけ強調する。
        </figcaption>
      </figure>
    ))
  }
</div>

<script>
  import { mountTrendCharts } from '../scripts/trend-chart';

  document.addEventListener('astro:page-load', mountTrendCharts);
</script>
