---
import '../styles/news-dialog.css';
import { formatDate } from '../lib/posts';
import NewsNewBadge from './NewsNewBadge.astro';
import { newsTag, type NewsSummaryArticle } from '../lib/news';

interface Props {
  article: NewsSummaryArticle;
}

const { article } = Astro.props;
const { title, url, source, tag, summary, image, categoryLabel, detailHtml, date, day } = article;
const { rank, originalTitle, points, comments, commentsUrl } = article;
const tagInfo = tag && newsTag(tag);
// HN の投稿はメタ行を「ポイント・コメント数・ドメイン」にする。source にはドメインが入っている
const hn = points !== undefined;
// Ask HN のようにリンク先が無い投稿は url がコメントページなので、元記事のボタンは出さない
const external = url !== commentsUrl;
---

<li
  class="news-item"
  data-tag={tagInfo?.id}
  style={tagInfo && `--tag-color: ${tagInfo.color}`}
  data-redpen-url={url}
  data-redpen-title={title}
  data-redpen-summary={summary}
>
  <!-- 常に元記事へのリンク。JS があるときだけ押下を奪ってモーダルにする -->
  <a
    class="news-card"
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    aria-haspopup={detailHtml ? 'dialog' : undefined}
  >
    {image && <img class="news-thumb" src={image} alt="" loading="lazy" decoding="async" />}
    <div class="news-body">
      <h2 class="news-title">
        {rank !== undefined && <span class="news-rank">{rank}.</span>}
        {title}
      </h2>
      {originalTitle && <p class="news-original" lang="en">{originalTitle}</p>}
      <p class="news-from">
        <NewsNewBadge day={day} />
        {
          hn ? (
            <>
              <span>{points} points</span>
              <span>{comments ?? 0} comments</span>
              <span>{source}</span>
            </>
          ) : (
            <span>from: {source}, {categoryLabel}</span>
          )
        }
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
      </p>
      {summary && <p class="news-summary">{summary}</p>}
    </div>
  </a>
  {
    detailHtml && (
      <dialog class="news-dialog">
        <div class="news-dialog-body">
          <header class="news-dialog-header">
            <div class="news-dialog-heading">
              <h2 class="news-dialog-title">{title}</h2>
              {originalTitle && <p class="news-original" lang="en">{originalTitle}</p>}
              <p class="news-from">
                {tagInfo && <span class="news-tag">{tagInfo.label}</span>}
                {
                  hn ? (
                    <>
                      <span>{points} points</span>
                      <span>{comments ?? 0} comments</span>
                      <span>{source}</span>
                    </>
                  ) : (
                    <span>from: {source}, {categoryLabel}</span>
                  )
                }
                <time datetime={date.toISOString()}>{formatDate(date)}</time>
              </p>
            </div>
            <div class="news-dialog-actions">
              {
                external && (
                  <a class="news-dialog-link" href={url} target="_blank" rel="noopener noreferrer">
                    元記事を開く ↗
                  </a>
                )
              }
              {
                commentsUrl && (
                  <a class="news-dialog-link" href={commentsUrl} target="_blank" rel="noopener noreferrer">
                    HN のコメント ↗
                  </a>
                )
              }
              <form method="dialog">
                <button class="news-dialog-close" aria-label="閉じる">×</button>
              </form>
            </div>
          </header>
          <div class="prose news-detail" set:html={detailHtml} />
        </div>
      </dialog>
    )
  }
</li>

<script>
  document.addEventListener('click', (event) => {
    const card = (event.target as Element)?.closest('.news-card[aria-haspopup]');
    if (!card) return;
    // cmd+クリックや中クリックは素通しして、元記事を新しいタブで開けるようにする
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) {
      return;
    }

    const dialog = card.closest('.news-item')?.querySelector<HTMLDialogElement>('.news-dialog');
    // ClientRouter で script が二重評価されても InvalidStateError を投げないようにする
    if (!dialog || dialog.open) return;
    event.preventDefault();
    dialog.showModal();
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    // ::backdrop への click は <dialog> 自身が受け取る
    if (target instanceof HTMLDialogElement && target.classList.contains('news-dialog')) {
      target.close();
    }
  });
</script>
