---
// 案A: 磨いたバンプチャート。最終日の上位8件だけを太い曲線で描き、右端に順位と名前をはっきり出す
import type { TrendSeries } from '../../lib/trend';
import { badge, featured, repoName, shortDay, stars } from './shared';

interface Props {
  series: TrendSeries;
}

const { series } = Astro.props;
const W = 720;
const LEFT = 28;
const RIGHT = 220;
const TOP = 18;
const ROW = 34;
const n = series.days.length;
const plotW = W - LEFT - RIGHT;
const x = (i: number) => (n === 1 ? LEFT + plotW / 2 : LEFT + (i * plotW) / (n - 1));
const y = (rank: number) => TOP + (rank - 1) * ROW;
const H = y(10) + 40;
// 日付は6個くらいまで。最後の日は必ず
const step = Math.ceil(n / 6);
const ticks = series.days.flatMap((day, i) => (i % step === 0 || i === n - 1 ? [{ x: x(i), label: shortDay(day) }] : []));

const lines = featured(series).map(({ repo, color }) => {
  // 隣り合う日を S 字の曲線でつなぐ。ランク外の日で切れる
  const segments: string[] = [];
  let d = '';
  repo.points.forEach((point, i) => {
    const prev = repo.points[i - 1];
    if (!point || point.rank > 10) {
      if (d) segments.push(d);
      d = '';
      return;
    }
    if (d && prev) {
      const mid = (x(i - 1) + x(i)) / 2;
      d += ` C${mid} ${y(prev.rank)} ${mid} ${y(point.rank)} ${x(i)} ${y(point.rank)}`;
    } else {
      d = `M${x(i)} ${y(point.rank)}`;
    }
  });
  if (d) segments.push(d);
  const dots = repo.points.flatMap((point, i) =>
    point && point.rank <= 10
      ? [{ cx: x(i), cy: y(point.rank), last: i === n - 1, title: `${shortDay(series.days[i])} ${point.rank}位 ${stars(point.stars) ?? ''}` }]
      : [],
  );
  return { repo, color, segments, dots, badge: badge(repo) };
});
const clip = (text: string) => (text.length > 18 ? `${text.slice(0, 17)}…` : text);
// 描く順は下位から。上位の線が上に重なる
const drawn = [...lines].reverse();
---

<div class="tl tl-bump">
  <div class="tl-scroll">
    <svg class="tl-bump-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`最終日の上位${lines.length}件の順位推移`}>
      {[1, 5, 10].map((rank) => <text class="tl-axis" x={LEFT - 12} y={y(rank)}>{rank}</text>)}
      {Array.from({ length: 10 }, (_, r) => <line class="tl-grid" x1={LEFT} x2={W - RIGHT + 8} y1={y(r + 1)} y2={y(r + 1)} />)}
      {ticks.map((tick) => <text class="tl-tick" x={tick.x} y={H - 10}>{tick.label}</text>)}
      {
        drawn.map(({ repo, color, segments, dots, badge }) => (
          <g class="tl-line" style={`--c: var(--series-${color})`}>
            {segments.map((d) => (
              <>
                <path class="tl-hit" d={d} />
                <path class="tl-path" d={d} />
              </>
            ))}
            {dots.map((dot) => (
              <circle class:list={['tl-dot', { 'is-last': dot.last }]} cx={dot.cx} cy={dot.cy} r={dot.last ? 5 : 3.5}>
                <title>{dot.title}</title>
              </circle>
            ))}
            {repo.lastRank && (
              <a href={repo.url} target="_blank" rel="noopener noreferrer">
                <rect class="tl-pill" x={x(n - 1) + 12} y={y(repo.lastRank) - 10} width="24" height="20" rx="10" />
                <text class="tl-pill-text" x={x(n - 1) + 24} y={y(repo.lastRank)}>{repo.lastRank}</text>
                <text class="tl-label" x={x(n - 1) + 42} y={y(repo.lastRank)}>
                  <tspan>{clip(repoName(repo.title))}</tspan>
                  {badge && <tspan class:list={['tl-badge', `is-${badge.kind}`]} dx="6">{badge.text}</tspan>}
                </text>
              </a>
            )}
          </g>
        ))
      }
    </svg>
  </div>
</div>
