---
// 案B: リポジトリごとのカード。最終日の順位・名前・印と、期間中の順位の小さなスパークラインを並べる
import type { TrendRepo, TrendSeries } from '../../lib/trend';
import { badge, featured, repoName, stars } from './shared';

interface Props {
  series: TrendSeries;
}

const { series } = Astro.props;
const SW = 140;
const SH = 40;

// 1位が上。ランク外の日で線が切れる
function spark(repo: TrendRepo) {
  const n = repo.points.length;
  const x = (i: number) => (n === 1 ? SW / 2 : 4 + (i * (SW - 8)) / (n - 1));
  const y = (rank: number) => 4 + ((Math.min(rank, 10) - 1) * (SH - 8)) / 9;
  const segments: string[] = [];
  let d = '';
  repo.points.forEach((point, i) => {
    const prev = repo.points[i - 1];
    if (!point) {
      if (d) segments.push(d);
      d = '';
      return;
    }
    if (d && prev) {
      const mid = (x(i - 1) + x(i)) / 2;
      d += ` C${mid} ${y(prev.rank)} ${mid} ${y(point.rank)} ${x(i)} ${y(point.rank)}`;
    } else {
      d = `M${x(i)} ${y(point.rank)}`;
    }
  });
  if (d) segments.push(d);
  const last = repo.points.at(-1);
  return { segments, end: last && { cx: x(n - 1), cy: y(last.rank) }, top: y(1), bottom: y(10) };
}

const cards = featured(series, 10).map(({ repo, color }) => ({
  repo,
  // 9件目以降は色を持たないのでグレー
  color: color <= 8 ? `var(--series-${color})` : 'var(--series-other)',
  badge: badge(repo),
  spark: spark(repo),
  owner: repo.title.split('/')[0],
  stars: stars(repo.points.at(-1)?.stars),
}));
---

<ol class="tl tl-cards">
  {
    cards.map(({ repo, color, badge, spark, owner, stars }) => (
      <li class="tl-card" style={`--c: ${color}`}>
        <span class="tl-card-rank">{repo.lastRank}</span>
        <div class="tl-card-body">
          <p class="tl-card-name">
            <a href={repo.url} target="_blank" rel="noopener noreferrer">
              {repoName(repo.title)}
            </a>
            {badge && <span class:list={['tl-chip', `is-${badge.kind}`]}>{badge.text}</span>}
          </p>
          <p class="tl-card-meta">
            {owner}
            {stars && <> ・ {stars}</>}
          </p>
          <p class="tl-card-meta">
            {series.days.length}日中{repo.daysRanked}日ランク入り・最高{repo.bestRank}位
          </p>
        </div>
        <svg class="tl-spark" viewBox={`0 0 ${SW} ${SH}`} aria-hidden="true">
          <line class="tl-grid" x1="0" x2={SW} y1={spark.top} y2={spark.top} />
          <line class="tl-grid" x1="0" x2={SW} y1={spark.bottom} y2={spark.bottom} />
          {spark.segments.map((d) => <path class="tl-path" d={d} />)}
          {spark.end && <circle class="tl-dot is-last" cx={spark.end.cx} cy={spark.end.cy} r="3.5" />}
        </svg>
      </li>
    ))
  }
</ol>
