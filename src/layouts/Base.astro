---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  // 本文の幅をモーダルと同じ 56rem まで広げる
  wide?: boolean;
}

const { title, description = SITE_DESCRIPTION, wide = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
// masthead slot を渡したページだけ、ヘッダーからその中身までをスクロールしても上に残す
const sticky = Astro.slots.has('masthead');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Zen+Kurenaido&display=swap" rel="stylesheet" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <ClientRouter />
  </head>
  <body class:list={{ 'is-wide': wide }}>
    <div class:list={['site-masthead', { 'is-sticky': sticky }]}>
      <header class="site-header">
        <a class="site-title" href="/">
          <img class="site-icon" src="/android-chrome-192x192.png" alt="" width="192" height="192" />
          {SITE_TITLE}
        </a>
        <nav>
          <a href="/news/xtrend/">my AI news</a>
        </nav>
      </header>
      <slot name="masthead" />
    </div>
    <main>
      <slot />
    </main>
    <footer class="site-footer">© {new Date().getFullYear()} {SITE_TITLE}</footer>
  </body>
</html>
