---
import '../../../styles/news.css';
import NewsTabs from '../../../components/NewsTabs.astro';
import WeeklyVideo from '../../../components/WeeklyVideo.astro';
import Base from '../../../layouts/Base.astro';
import { getNewsWeeks, getWeeklyVideoPage, type WeekId } from '../../../lib/weekly';

export async function getStaticPaths() {
  return (await getNewsWeeks()).map((week) => ({ params: { week } }));
}

const week = Astro.params.week as WeekId;
const page = await getWeeklyVideoPage(week);
---

<Base wide title={`news / ${week} の週`} description={`AI が集めたニュースの ${week} の週のまとめ動画`}>
  <Fragment slot="masthead">
    <NewsTabs active="weekly" />
  </Fragment>
  <WeeklyVideo page={page} />
</Base>
