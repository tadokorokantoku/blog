---
import '../../../styles/news.css';
import NewsTabs from '../../../components/NewsTabs.astro';
import WeeklyVideo from '../../../components/WeeklyVideo.astro';
import Base from '../../../layouts/Base.astro';
import { getNewsWeeks, getWeeklyVideoPage } from '../../../lib/weekly';

// 最新の週を出す。中身は /news/weekly/<その週>/ と同じ
const weeks = await getNewsWeeks();
const page = weeks[0] && (await getWeeklyVideoPage(weeks[0]));
---

<Base wide title="news / 週のまとめ" description="AI が集めたニュースの週のまとめ動画">
  <Fragment slot="masthead">
    <h1 class="news-heading">news</h1>
    <NewsTabs active="weekly" />
  </Fragment>
  {page ? <WeeklyVideo page={page} /> : <p class="news-empty">まだ何も集まっていない。</p>}
</Base>
