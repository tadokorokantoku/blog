---
import '../../../styles/news.css';
import NewsTabs from '../../../components/NewsTabs.astro';
import WeeklyDigest from '../../../components/WeeklyDigest.astro';
import RedPen from '../../../components/RedPen.astro';
import Base from '../../../layouts/Base.astro';
import { getNewsWeeks, getWeeklyDigest } from '../../../lib/weekly';

// 最新の週を出す。中身は /news/weekly/<その週>/ と同じ
const weeks = await getNewsWeeks();
const digest = weeks[0] && (await getWeeklyDigest(weeks[0]));
---

<Base wide title="news / 週のまとめ" description="AI が集めたニュースの週のまとめ">
  <Fragment slot="masthead">
    <h1 class="news-heading">news</h1>
    <NewsTabs active="weekly" />
  </Fragment>
  {digest ? <WeeklyDigest digest={digest} weeks={weeks} /> : <p class="news-empty">まだ何も集まっていない。</p>}
  <RedPen />
</Base>
