---
import '../../styles/news.css';
import NewsItem from '../../components/NewsItem.astro';
import NewsTabs from '../../components/NewsTabs.astro';
import Base from '../../layouts/Base.astro';
import { getNewsArticles } from '../../lib/news';

const articles = await getNewsArticles();
---

<Base title="news" description="AI が集めたニュース">
  <h1 class="news-heading">news</h1>
  <NewsTabs />
  {articles.length === 0 && <p class="news-empty">まだ何も集まっていない。</p>}
  {
    articles.length > 0 && (
      <ul class="news-list">
        {articles.map((article) => (
          <NewsItem article={article} />
        ))}
      </ul>
    )
  }
</Base>
