---
import '../../styles/news.css';
import NewsItem from '../../components/NewsItem.astro';
import NewsRankingTable from '../../components/NewsRankingTable.astro';
import NewsTabs from '../../components/NewsTabs.astro';
import Base from '../../layouts/Base.astro';
import { getNewsCategoryView, newsCategoryList, type NewsCategory } from '../../lib/news';

export function getStaticPaths() {
  return newsCategoryList().map(({ id, label }) => ({ params: { category: id }, props: { label } }));
}

interface Props {
  label: string;
}

const category = Astro.params.category as NewsCategory;
const { label } = Astro.props;
const view = await getNewsCategoryView(category);
const empty = view.layout === 'ranking' ? view.ranking === null : view.articles.length === 0;
---

<Base title={`news / ${label}`} description={`AI が集めた${label}のニュース`}>
  <Fragment slot="masthead">
    <h1 class="news-heading">news</h1>
    <NewsTabs active={category} />
  </Fragment>
  {empty && <p class="news-empty">まだ何も集まっていない。</p>}
  {view.layout === 'ranking' && view.ranking && <NewsRankingTable ranking={view.ranking} />}
  {
    view.layout === 'list' && view.articles.length > 0 && (
      <ul class="news-list">
        {view.articles.map((article) => (
          <NewsItem article={article} />
        ))}
      </ul>
    )
  }
</Base>
