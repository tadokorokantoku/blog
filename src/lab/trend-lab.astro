---
// 推移グラフの比較ページ（dev のみ。src/integrations/dev-trend-lab.ts が足す）
import '../styles/news.css';
import '../styles/news-trend.css';
import '../styles/trend-lab.css';
import NewsTabs from '../components/NewsTabs.astro';
import TrendBump from '../components/trend-lab/TrendBump.astro';
import TrendCards from '../components/trend-lab/TrendCards.astro';
import TrendHeatmap from '../components/trend-lab/TrendHeatmap.astro';
import Base from '../layouts/Base.astro';
import { getRankingSeries } from '../lib/news';
import { lastDays } from '../lib/trend';

const all = await getRankingSeries('githubtrend');
const ranges = [
  { id: '7d', label: '直近7日', series: lastDays(all, 7) },
  { id: 'all', label: '全期間', series: all },
];
const variants = [
  { id: 'a', title: '案A: バンプチャート', note: '最終日の上位8件だけを太い曲線で。右端に現順位と名前、NEW / ↑n は名前の横にだけ出す。', Component: TrendBump },
  { id: 'b', title: '案B: スパークライン付きカード', note: '最終日の上位10件をカードで。順位・名前・印・スター、右に期間中の順位の小さな線。', Component: TrendCards },
  { id: 'c', title: '案C: 順位ヒートマップ', note: '行がリポジトリ、列が日付。上位ほど濃い青。誰がいつ居たかを一望する。', Component: TrendHeatmap },
];
---

<Base wide title="news / 推移グラフの比較" description="GitHub トレンドの推移の見せ方を3案並べる（dev のみ）">
  <Fragment slot="masthead">
    <h1 class="news-heading">news</h1>
    <NewsTabs active="githubtrend" />
  </Fragment>
  <p class="tl-note">開発サーバーだけの比較ページ。1案に決めたら /news/githubtrend/#trend に入れ、ほかは消す。</p>
  <div class="trend-ranges" role="group" aria-label="期間" style="margin-top: 1rem">
    {
      ranges.map((range, i) => (
        <button type="button" class="trend-range" data-lab-range={range.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          {range.label}
        </button>
      ))
    }
  </div>
  {
    variants.map(({ id, title, note, Component }) => (
      <section class="lab-variant" id={id}>
        <h2 class="lab-title">{title}</h2>
        <p class="tl-note">{note}</p>
        {ranges.map((range, i) => (
          <div class="lab-range" data-lab-range={range.id} hidden={i !== 0}>
            <Component series={range.series} />
          </div>
        ))}
      </section>
    ))
  }
</Base>

<style>
  .lab-variant {
    margin-top: 2.5rem;
  }

  .lab-title {
    margin: 0 0 0.25rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--border);
    font-size: 1.0625rem;
  }

  .lab-range {
    margin-top: 0.75rem;
  }
</style>

<script>
  // 最新の日が右端にあるので、横スクロールになる狭い画面では右端から見せる
  function scrollToEnd() {
    for (const scroller of document.querySelectorAll<HTMLElement>('.lab-range:not([hidden]) .tl-scroll')) {
      scroller.scrollLeft = scroller.scrollWidth;
    }
  }
  document.addEventListener('astro:page-load', scrollToEnd);

  document.addEventListener('click', (event) => {
    const button = (event.target as Element)?.closest<HTMLButtonElement>('button[data-lab-range]');
    if (!button) return;
    for (const other of document.querySelectorAll('button[data-lab-range]')) {
      other.setAttribute('aria-pressed', String(other === button));
    }
    for (const range of document.querySelectorAll<HTMLElement>('.lab-range')) {
      range.hidden = range.dataset.labRange !== button.dataset.labRange;
    }
    scrollToEnd();
  });
</script>
