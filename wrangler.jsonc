{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "compatibility_date": "2026-09-01",
  // 独自ドメイン。deploy のたびに Workers のカスタムドメインとして登録される
  "routes": [{ "pattern": "inok.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
