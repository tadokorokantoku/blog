{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "compatibility_date": "2026-09-01",
  // 独自ドメイン。deploy のたびに Workers のカスタムドメインとして登録される
  "routes": [{ "pattern": "inok.dev", "custom_domain": true }],
  // *.workers.dev は使わない。独自ドメインと同じ内容が2つの URL で見える状態を避ける
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // ブランチのビルド（npx wrangler preview）が要求する。中身は空で、本番と同じ設定で Preview を作る
  "previews": {}
}
